[
 {
  "id": "p0_l00",
  "start": 0.6,
  "end": 4.09,
  "text": "Pékin, le 19 avril 2026,"
 },
 {
  "id": "p0_l00",
  "start": 4.09,
  "end": 6.2,
  "text": "7 h 30 du matin."
 },
 {
  "id": "p0_l01",
  "start": 6.52,
  "end": 11.24,
  "text": "Un robot humanoïde d'1,69 m s'élance sur un semi-marathon."
 },
 {
  "id": "p0_l02",
  "start": 11.56,
  "end": 14.163,
  "text": "Il franchit la ligne en 50 minutes"
 },
 {
  "id": "p0_l02",
  "start": 14.163,
  "end": 15.56,
  "text": "et 26 secondes."
 },
 {
  "id": "p0_l03",
  "start": 15.88,
  "end": 17.584,
  "text": "Le record du monde humain,"
 },
 {
  "id": "p0_l03",
  "start": 17.584,
  "end": 19.857,
  "text": "établi un mois plus tôt à Lisbonne,"
 },
 {
  "id": "p0_l03",
  "start": 19.857,
  "end": 22.76,
  "text": "est de 57 minutes et 20 secondes."
 },
 {
  "id": "p0_l04",
  "start": 23.08,
  "end": 23.949,
  "text": "Un an avant,"
 },
 {
  "id": "p0_l04",
  "start": 23.949,
  "end": 25.286,
  "text": "sur la même course,"
 },
 {
  "id": "p0_l04",
  "start": 25.286,
  "end": 27.96,
  "text": "le vainqueur avait mis 2 h 40."
 },
 {
  "id": "p0_l05",
  "start": 28.28,
  "end": 30.094,
  "text": "Ce robot ne sort pas de la"
 },
 {
  "id": "p0_l05",
  "start": 30.094,
  "end": 32.445,
  "text": "Silicon Valley. Il a été conçu par"
 },
 {
  "id": "p0_l05",
  "start": 32.445,
  "end": 35.4,
  "text": "Honor, un fabricant chinois de smartphones."
 },
 {
  "id": "p0_l06",
  "start": 35.72,
  "end": 37.103,
  "text": "Pendant 40 ans,"
 },
 {
  "id": "p0_l06",
  "start": 37.103,
  "end": 39.24,
  "text": "on a répété que la Chine copiait."
 },
 {
  "id": "p0_l07",
  "start": 39.56,
  "end": 43.56,
  "text": "Aujourd'hui, c'est elle qu'on regarde pour deviner la suite."
 },
 {
  "id": "p0_l08",
  "start": 43.88,
  "end": 46.34,
  "text": "Pour comprendre comment on en est arrivé"
 },
 {
  "id": "p0_l08",
  "start": 46.34,
  "end": 48.14,
  "text": "là, il faut revenir à un pays"
 },
 {
  "id": "p0_l08",
  "start": 48.14,
  "end": 51.32,
  "text": "où l'on vivait avec moins d'un demi-dollar par jour."
 },
 {
  "id": "p1_l00",
  "start": 53.82,
  "end": 56.7,
  "text": "1978."
 },
 {
  "id": "p1_l01",
  "start": 57.02,
  "end": 58.79,
  "text": "Selon la Banque mondiale,"
 },
 {
  "id": "p1_l01",
  "start": 58.79,
  "end": 61.241,
  "text": "le revenu par habitant en Chine est"
 },
 {
  "id": "p1_l01",
  "start": 61.241,
  "end": 63.42,
  "text": "de 157 dollars par an."
 },
 {
  "id": "p1_l02",
  "start": 63.74,
  "end": 67.247,
  "text": "Cette année-là, Deng Xiaoping lance la politique"
 },
 {
  "id": "p1_l02",
  "start": 67.247,
  "end": 69.18,
  "text": "de réforme et d'ouverture."
 },
 {
  "id": "p1_l03",
  "start": 69.5,
  "end": 71.291,
  "text": "Le Parti garde le pouvoir,"
 },
 {
  "id": "p1_l03",
  "start": 71.291,
  "end": 73.68,
  "text": "mais il laisse entrer le marché par"
 },
 {
  "id": "p1_l03",
  "start": 73.68,
  "end": 74.94,
  "text": "de petites portes."
 },
 {
  "id": "p1_l04",
  "start": 75.26,
  "end": 78.304,
  "text": "La première s'ouvre en 1980,"
 },
 {
  "id": "p1_l04",
  "start": 78.304,
  "end": 80.456,
  "text": "juste en face de Hong Kong :"
 },
 {
  "id": "p1_l04",
  "start": 80.456,
  "end": 83.5,
  "text": "la zone économique spéciale de Shenzhen."
 },
 {
  "id": "p1_l05",
  "start": 83.82,
  "end": 88.504,
  "text": "En 1979, environ 300 000 personnes vivent"
 },
 {
  "id": "p1_l05",
  "start": 88.504,
  "end": 89.74,
  "text": "sur ce territoire."
 },
 {
  "id": "p1_l06",
  "start": 90.06,
  "end": 94.06,
  "text": "Fin 2025, elles sont plus de 18 millions."
 },
 {
  "id": "p1_l07",
  "start": 94.38,
  "end": 97.014,
  "text": "Shenzhen fabrique d'abord pour les autres,"
 },
 {
  "id": "p1_l07",
  "start": 97.014,
  "end": 98.3,
  "text": "puis pour elle-même."
 },
 {
  "id": "p1_l08",
  "start": 98.62,
  "end": 102.62,
  "text": "Huawei, Tencent et BYD y sont nés."
 },
 {
  "id": "p1_l09",
  "start": 102.94,
  "end": 103.964,
  "text": "En 40 ans,"
 },
 {
  "id": "p1_l09",
  "start": 103.964,
  "end": 106.734,
  "text": "près de 800 millions de Chinois sont"
 },
 {
  "id": "p1_l09",
  "start": 106.734,
  "end": 108.54,
  "text": "sortis de l'extrême pauvreté."
 },
 {
  "id": "p1_l10",
  "start": 108.86,
  "end": 111.044,
  "text": "C'est presque les trois quarts du recul"
 },
 {
  "id": "p1_l10",
  "start": 111.044,
  "end": 113.5,
  "text": "de la pauvreté dans le monde sur la période."
 },
 {
  "id": "p1_l11",
  "start": 113.82,
  "end": 115.405,
  "text": "Et en 2025,"
 },
 {
  "id": "p1_l11",
  "start": 115.405,
  "end": 119.5,
  "text": "le revenu par habitant dépasse 13 800 dollars."
 },
 {
  "id": "p1_l12",
  "start": 119.82,
  "end": 124.3,
  "text": "Près de 90 fois le chiffre de 1978."
 },
 {
  "id": "p2_l00",
  "start": 126.8,
  "end": 130.023,
  "text": "Longtemps, l'Occident s'est rassuré avec une idée"
 },
 {
  "id": "p2_l00",
  "start": 130.023,
  "end": 131.828,
  "text": "simple : la Chine fabrique,"
 },
 {
  "id": "p2_l00",
  "start": 131.828,
  "end": 133.44,
  "text": "mais elle n'invente pas."
 },
 {
  "id": "p2_l01",
  "start": 133.76,
  "end": 136.32,
  "text": "Janvier 2025."
 },
 {
  "id": "p2_l02",
  "start": 136.64,
  "end": 138.99,
  "text": "Une jeune entreprise de Hangzhou,"
 },
 {
  "id": "p2_l02",
  "start": 138.99,
  "end": 143.76,
  "text": "DeepSeek, publie un modèle d'intelligence artificielle appelé R1."
 },
 {
  "id": "p2_l03",
  "start": 144.08,
  "end": 147.12,
  "text": "Il tient tête aux meilleurs modèles américains."
 },
 {
  "id": "p2_l04",
  "start": 147.44,
  "end": 150.928,
  "text": "DeepSeek affirme avoir dépensé environ 5,6 millions"
 },
 {
  "id": "p2_l04",
  "start": 150.928,
  "end": 153.153,
  "text": "de dollars de calcul pour son modèle"
 },
 {
  "id": "p2_l04",
  "start": 153.153,
  "end": 156.16,
  "text": "de base, un chiffre que des analystes contestent."
 },
 {
  "id": "p2_l05",
  "start": 156.48,
  "end": 158.214,
  "text": "Et le tout sur des puces bridées"
 },
 {
  "id": "p2_l05",
  "start": 158.214,
  "end": 160.0,
  "text": "par les restrictions américaines."
 },
 {
  "id": "p2_l06",
  "start": 160.32,
  "end": 162.128,
  "text": "Le lundi 27 janvier,"
 },
 {
  "id": "p2_l06",
  "start": 162.128,
  "end": 166.48,
  "text": "Nvidia perd environ 589 milliards de dollars en bourse."
 },
 {
  "id": "p2_l07",
  "start": 166.8,
  "end": 169.798,
  "text": "Aucune entreprise n'avait jamais perdu autant en"
 },
 {
  "id": "p2_l07",
  "start": 169.798,
  "end": 170.96,
  "text": "une seule journée."
 },
 {
  "id": "p2_l08",
  "start": 171.28,
  "end": 174.0,
  "text": "Ce choc ne tombe pas du ciel."
 },
 {
  "id": "p2_l09",
  "start": 174.32,
  "end": 179.275,
  "text": "L'institut australien ASPI suit 74 technologies jugées critiques."
 },
 {
  "id": "p2_l10",
  "start": 179.595,
  "end": 182.142,
  "text": "Sur les publications les plus citées entre"
 },
 {
  "id": "p2_l10",
  "start": 182.142,
  "end": 184.393,
  "text": "2021 et 2025,"
 },
 {
  "id": "p2_l10",
  "start": 184.393,
  "end": 187.355,
  "text": "la Chine est en tête dans 69 d'entre elles."
 },
 {
  "id": "p2_l11",
  "start": 187.675,
  "end": 189.755,
  "text": "Au milieu des années 2000,"
 },
 {
  "id": "p2_l11",
  "start": 189.755,
  "end": 191.195,
  "text": "elle n'en menait que 3."
 },
 {
  "id": "p3_l00",
  "start": 193.695,
  "end": 195.629,
  "text": "Mais une IA sans électricité,"
 },
 {
  "id": "p3_l00",
  "start": 195.629,
  "end": 198.015,
  "text": "ce n'est qu'un programme qui attend."
 },
 {
  "id": "p3_l01",
  "start": 198.335,
  "end": 200.132,
  "text": "Et sur l'électricité,"
 },
 {
  "id": "p3_l01",
  "start": 200.132,
  "end": 202.255,
  "text": "l'écart donne le vertige."
 },
 {
  "id": "p3_l02",
  "start": 202.575,
  "end": 205.757,
  "text": "En 2025, la Chine a raccordé plus"
 },
 {
  "id": "p3_l02",
  "start": 205.757,
  "end": 209.215,
  "text": "de 430 gigawatts d'éolien et de solaire."
 },
 {
  "id": "p3_l03",
  "start": 209.535,
  "end": 211.135,
  "text": "En une seule année."
 },
 {
  "id": "p3_l04",
  "start": 211.455,
  "end": 212.839,
  "text": "Pour la première fois,"
 },
 {
  "id": "p3_l04",
  "start": 212.839,
  "end": 214.946,
  "text": "le vent et le soleil dépassent les"
 },
 {
  "id": "p3_l04",
  "start": 214.946,
  "end": 217.775,
  "text": "centrales thermiques dans son parc électrique."
 },
 {
  "id": "p3_l05",
  "start": 218.095,
  "end": 221.186,
  "text": "Sa production renouvelable atteint environ 4 000"
 },
 {
  "id": "p3_l05",
  "start": 221.186,
  "end": 222.655,
  "text": "milliards de kilowattheures."
 },
 {
  "id": "p3_l06",
  "start": 222.975,
  "end": 225.929,
  "text": "Plus que toute l'électricité consommée par les"
 },
 {
  "id": "p3_l06",
  "start": 225.929,
  "end": 228.255,
  "text": "27 pays de l'Union européenne."
 },
 {
  "id": "p3_l07",
  "start": 228.575,
  "end": 232.015,
  "text": "Cette électricité, il faut ensuite la stocker."
 },
 {
  "id": "p3_l08",
  "start": 232.335,
  "end": 234.82,
  "text": "Selon l'Agence internationale de l'énergie,"
 },
 {
  "id": "p3_l08",
  "start": 234.82,
  "end": 236.796,
  "text": "plus de 80 % des cellules de"
 },
 {
  "id": "p3_l08",
  "start": 236.796,
  "end": 239.846,
  "text": "batteries produites dans le monde en 2025"
 },
 {
  "id": "p3_l08",
  "start": 239.846,
  "end": 240.975,
  "text": "sortaient de Chine."
 },
 {
  "id": "p3_l09",
  "start": 241.295,
  "end": 243.399,
  "text": "Et pour les matériaux à l'intérieur de"
 },
 {
  "id": "p3_l09",
  "start": 243.399,
  "end": 245.935,
  "text": "ces batteries, sa part est encore plus élevée."
 },
 {
  "id": "p4_l00",
  "start": 248.435,
  "end": 250.395,
  "text": "Des batteries à la voiture,"
 },
 {
  "id": "p4_l00",
  "start": 250.395,
  "end": 251.795,
  "text": "il n'y a qu'un pas."
 },
 {
  "id": "p4_l01",
  "start": 252.115,
  "end": 255.679,
  "text": "En 2025, près de 3 voitures électriques"
 },
 {
  "id": "p4_l01",
  "start": 255.679,
  "end": 258.141,
  "text": "sur 4 produites dans le monde sont"
 },
 {
  "id": "p4_l01",
  "start": 258.141,
  "end": 259.955,
  "text": "sorties d'usines chinoises."
 },
 {
  "id": "p4_l02",
  "start": 260.275,
  "end": 261.37,
  "text": "La même année,"
 },
 {
  "id": "p4_l02",
  "start": 261.37,
  "end": 264.143,
  "text": "BYD, une société fondée à Shenzhen en"
 },
 {
  "id": "p4_l02",
  "start": 264.143,
  "end": 267.573,
  "text": "1995 pour fabriquer des batteries,"
 },
 {
  "id": "p4_l02",
  "start": 267.573,
  "end": 272.755,
  "text": "a vendu 2,26 millions de voitures 100 % électriques."
 },
 {
  "id": "p4_l03",
  "start": 273.075,
  "end": 276.515,
  "text": "Tesla en a livré 1,64 million."
 },
 {
  "id": "p4_l04",
  "start": 276.835,
  "end": 279.427,
  "text": "Pour la première fois sur une année"
 },
 {
  "id": "p4_l04",
  "start": 279.427,
  "end": 281.875,
  "text": "entière, l'américain est dépassé."
 },
 {
  "id": "p4_l05",
  "start": 282.195,
  "end": 283.342,
  "text": "Dans les usines,"
 },
 {
  "id": "p4_l05",
  "start": 283.342,
  "end": 285.635,
  "text": "la machine prend aussi le relais."
 },
 {
  "id": "p4_l06",
  "start": 285.955,
  "end": 289.232,
  "text": "En 2024, la Chine a installé 295"
 },
 {
  "id": "p4_l06",
  "start": 289.232,
  "end": 291.235,
  "text": "000 robots industriels."
 },
 {
  "id": "p4_l07",
  "start": 291.555,
  "end": 295.315,
  "text": "Plus d'un robot sur deux installés sur la planète."
 },
 {
  "id": "p4_l08",
  "start": 295.635,
  "end": 297.329,
  "text": "Et pour la première fois,"
 },
 {
  "id": "p4_l08",
  "start": 297.329,
  "end": 300.195,
  "text": "la majorité venaient de fabricants chinois."
 },
 {
  "id": "p4_l09",
  "start": 300.515,
  "end": 303.302,
  "text": "Les humanoïdes du semi-marathon ne sont que"
 },
 {
  "id": "p4_l09",
  "start": 303.302,
  "end": 305.075,
  "text": "la vitrine de ce mouvement."
 },
 {
  "id": "p5_l00",
  "start": 307.575,
  "end": 310.573,
  "text": "L'investisseur américain Ray Dalio a étudié cinq"
 },
 {
  "id": "p5_l00",
  "start": 310.573,
  "end": 311.796,
  "text": "siècles d'empires :"
 },
 {
  "id": "p5_l00",
  "start": 311.796,
  "end": 314.61,
  "text": "les Provinces-Unies, puis la Grande-Bretagne,"
 },
 {
  "id": "p5_l00",
  "start": 314.61,
  "end": 315.895,
  "text": "puis les États-Unis."
 },
 {
  "id": "p5_l01",
  "start": 316.215,
  "end": 320.855,
  "text": "Pour lui, la puissance suit un grand cycle."
 },
 {
  "id": "p5_l02",
  "start": 321.175,
  "end": 323.217,
  "text": "On monte en éduquant,"
 },
 {
  "id": "p5_l02",
  "start": 323.217,
  "end": 325.815,
  "text": "en innovant, en produisant."
 },
 {
  "id": "p5_l03",
  "start": 326.135,
  "end": 328.179,
  "text": "Puis viennent la dette,"
 },
 {
  "id": "p5_l03",
  "start": 328.179,
  "end": 330.223,
  "text": "les divisions internes,"
 },
 {
  "id": "p5_l03",
  "start": 330.223,
  "end": 331.415,
  "text": "et le déclin."
 },
 {
  "id": "p5_l04",
  "start": 331.735,
  "end": 334.384,
  "text": "Dans son livre de 2021,"
 },
 {
  "id": "p5_l04",
  "start": 334.384,
  "end": 336.885,
  "text": "il décrit une puissance montante,"
 },
 {
  "id": "p5_l04",
  "start": 336.885,
  "end": 339.975,
  "text": "la Chine, qui défie la puissance établie."
 },
 {
  "id": "p5_l05",
  "start": 340.295,
  "end": 342.535,
  "text": "Rien n'est écrit pour autant."
 },
 {
  "id": "p5_l06",
  "start": 342.855,
  "end": 345.454,
  "text": "La population chinoise a encore reculé en"
 },
 {
  "id": "p5_l06",
  "start": 345.454,
  "end": 348.114,
  "text": "2025, l'immobilier a souffert,"
 },
 {
  "id": "p5_l06",
  "start": 348.114,
  "end": 350.775,
  "text": "et les tensions commerciales s'accumulent."
 },
 {
  "id": "p5_l07",
  "start": 351.095,
  "end": 353.415,
  "text": "Mais une chose a déjà basculé."
 },
 {
  "id": "p5_l08",
  "start": 353.735,
  "end": 356.024,
  "text": "Le pays qu'on accusait de copier est"
 },
 {
  "id": "p5_l08",
  "start": 356.024,
  "end": 358.375,
  "text": "devenu celui que les autres étudient."
 },
 {
  "id": "p5_l09",
  "start": 358.695,
  "end": 361.338,
  "text": "Alors, le prochain robot qui battra un"
 },
 {
  "id": "p5_l09",
  "start": 361.338,
  "end": 363.575,
  "text": "record humain, il viendra d'où ?"
 },
 {
  "id": "p5_l10",
  "start": 363.895,
  "end": 366.353,
  "text": "Dites-le en commentaire :"
 },
 {
  "id": "p5_l10",
  "start": 366.353,
  "end": 369.095,
  "text": "Chine, États-Unis ou Europe."
 }
]